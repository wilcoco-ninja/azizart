# ══════════════════════════════════════════════════════════════════════
# AZIZART — modèle de .env  (copie en « .env » puis remplis les valeurs)
# Format obligatoire : CLE=valeur  (pas de « : », pas de virgule finale)
#
# ⚠️  Le vrai .env contient des SECRETS : ne jamais le commiter ni le
#     coller dans un chat/mail. Il sert UNIQUEMENT à scripts/deploy_backend.sh.
#     Ne le passe JAMAIS à `flutter --dart-define-from-file` : pour Flutter,
#     utilise env.json (valeurs publiques uniquement).
# ══════════════════════════════════════════════════════════════════════

# ── Cloudflare R2 → secrets de la fonction Edge r2-presign ────────────
R2_ACCOUNT_ID=
R2_BUCKET_NAME=azizart-media
# URL publique des médias, SANS « / » final.
# Production : https://media.azizart.com (voir README, étape 5)
R2_PUBLIC_URL=https://pub-683ade17eed84c96a53d0631e8f03742.r2.dev

# Jeton R2 limité au bucket azizart-media, permission « Object Read & Write »
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# ── Supabase (publics : déjà dans env.json pour le build Flutter) ─────
SUPABASE_URL=https://nqzrynteyovxzvahonpx.supabase.co
SUPABASE_ANON_KEY=sb_publishable_JiIWJ1SGBT7DoBM9ZiIolg_nd3qoLI3
BASE_URL=https://azizart.com
