# ═══════════════════════════════════════════════════════════════
# Variables d'environnement & secrets
# ═══════════════════════════════════════════════════════════════
.env
.env.*
!.env.example
supabase/functions/.env

# Clés, certificats et signatures (Android / iOS / serveurs)
*.pem
*.key
*.p12
*.jks
*.keystore
key.properties

# ═══════════════════════════════════════════════════════════════
# Flutter SDK cloné par Vercel (à la racine uniquement !)
# ⚠️ Le "/" initial est essentiel : sans lui, `flutter/` ignorerait aussi
#    windows/flutter/, linux/flutter/, ios/Flutter/ et macos/Flutter/,
#    qui contiennent des fichiers nécessaires au build.
# ═══════════════════════════════════════════════════════════════
/flutter/
/.flutter/

# ═══════════════════════════════════════════════════════════════
# Builds et dépendances
# ═══════════════════════════════════════════════════════════════
build/
.dart_tool/
.packages
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
coverage/
node_modules/
app.*.symbols
app.*.map.json

# ═══════════════════════════════════════════════════════════════
# Outils de déploiement / backend local
# ═══════════════════════════════════════════════════════════════
.vercel
.vercel/
.wrangler/
supabase/.temp/
supabase/.branches/

# ═══════════════════════════════════════════════════════════════
# IDE
# ═══════════════════════════════════════════════════════════════
.idea/
.vscode/
*.iml
*.ipr
*.iws
*.log

# ═══════════════════════════════════════════════════════════════
